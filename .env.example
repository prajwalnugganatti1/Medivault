# ==========================================
# MediVault - Environment Configuration Template
# ==========================================

# 1. Server Port
PORT=3000

# 2. MSG91 Official OTP Service (Optional - Demo OTP 123456 works without keys)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY=10

# 3. Gmail SMTP Configuration (Optional - For Doctor/Admin credential change OTP)
GMAIL_USER=
GMAIL_APP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
